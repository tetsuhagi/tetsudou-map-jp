# Cloudflare Pages _headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Global security headers — applied to every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# HTML entry point: never cache. The browser always fetches the latest
# index.html, which references the current src/app.js?v=N.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Everything fetched via the ?v=N cache buster (JS modules, CSV timetables,
# JSON geometry, icon PNGs) can be cached forever and marked immutable.
# Bumping V (see src/data.js) invalidates automatically because the URL
# itself changes — old cached copies are simply never requested again.
/src/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

# /assets/ は「必ず ?v=N 付きで読み込むもの」だけを永久キャッシュにする。
# サムネ（og）と記事内イラスト（img）は ?v= 無しで参照されるため、ここに含めない。
# （2026-09: 画像のコミットが遅れた間に返ったトップページのHTMLが、/assets/* の
#   immutable 指定で1年キャッシュされ、サムネが表示されなくなる事故があった）
# ※ 同じヘッダーが複数ルールに当たると値がカンマ結合されるため、範囲を重ねないこと。
/assets/content.css
  Cache-Control: public, max-age=31536000, immutable

/assets/tts.js
  Cache-Control: public, max-age=31536000, immutable

/assets/site-nav.js
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ?v= 無しの画像: 差し替えや配信事故が1時間以内に解消されるようにする
/assets/og/*
  Cache-Control: public, max-age=3600

/assets/img/*
  Cache-Control: public, max-age=3600

# SEO files: cache short-term so updates propagate within an hour.
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400
